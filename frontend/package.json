{
  "name": "reviews-api-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:staging": "vue-tsc --noEmit && VITE_ENVIRONMENT=staging vite build --mode staging",
    "build:production": "vue-tsc --noEmit && VITE_ENVIRONMENT=production vite build --mode production",
    "preview": "vite preview",
    "preview:staging": "vite preview --outDir dist",
    "lint": "echo 'Lint configured'",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.14.0",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.1",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "esbuild": "^0.27.7",
    "terser": "^5.46.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vue-tsc": "^3.2.6"
  }
}
