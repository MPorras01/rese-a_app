# === RESEÑA APP - ENVIRONMENT CONFIGURATION ===
#
# Copy this file to .env and update values for your environment
# DO NOT commit the actual .env file with secrets to version control
#
# ──────────────────────────────────────────────────────────────────────────────
# AWS (para docker-compose.aws.yml en EC2)
# ──────────────────────────────────────────────────────────────────────────────
# DB_URL=jdbc:postgresql://reseniaapp-db.xxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/resenias
# DB_USERNAME=resenias
# DB_PASSWORD=your_rds_password
#
# Genera JWT_SECRET con:    openssl rand -base64 64
# Genera OTP_JWT_SECRET con: openssl rand -hex 32
# JWT_SECRET=
# OTP_JWT_SECRET=
#
# APP_FRONTEND_URL=http://TU_ELASTIC_IP
#

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE
# ──────────────────────────────────────────────────────────────────────────────
DB_USER=resena
DB_PASSWORD=your_secure_password_here
DB_NAME=resena_db
DB_PORT=5432
DB_POOL_SIZE=20

# ──────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────────────────────
APP_PORT=8080
SPRING_PROFILES=docker
SPRING_ENVIRONMENT=production

# ──────────────────────────────────────────────────────────────────────────────
# JWT & SECURITY
# ──────────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRATION=86400

# ──────────────────────────────────────────────────────────────────────────────
# OAUTH2 PROVIDERS
# ──────────────────────────────────────────────────────────────────────────────
# Google OAuth2
# Get credentials from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth2
# Get credentials from: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# ──────────────────────────────────────────────────────────────────────────────
# FRONTEND
# ──────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:8080

# ──────────────────────────────────────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────────────────
# DOCKER RESOURCE LIMITS (for Dokploy)
# ──────────────────────────────────────────────────────────────────────────────
CPU_LIMIT=2
MEMORY_LIMIT=1024M
CPU_REQUEST=500m
MEMORY_REQUEST=512M

# ──────────────────────────────────────────────────────────────────────────────
# OPTIONAL: MONITORING
# ──────────────────────────────────────────────────────────────────────────────
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
# DATADOG_API_KEY=your_datadog_api_key
